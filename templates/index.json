    "brand_list_Bb7KJE": {
      "type": "brand-list",
      "blocks": {
        "card_pcGKxw": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/logo1.jpg",
            "description": "„Mit dem Indevolt BK1600 holen Sie sich mehr als ein Balkonkraftwerk nach Hause - Sie erleben UnabhangigkeitNachhaltigkeit und innovative Energieversorgung in einem kompakten System.\""
