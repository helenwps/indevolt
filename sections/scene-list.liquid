{{ 'component-scene-card.css' | asset_url | stylesheet_tag }}
<style>
   .product{margin-top:118px}
   .product h2{ font-size: 46px;font-weight: 700;text-align:center;color:#000}
   .product-box{margin-top:57px}
   .product-box ul{display:grid; grid-template-columns: repeat(4, 1fr);gap:1rem;}
   .product-box .slick-track{display:flex;gap:1rem}
   .product-box .custom-product-title,.product-box .custom-product-price{margin-top:20px;text-align: center; font-size: 20px;font-weight: 600;color: #1A1A1A;}
   .product-box .custom-product-describe{margin-top:5px;font-size:14px;font-weight: 400;color: #1A1A1A;text-align: center;}
   .product-box .custom-product-price{margin-top:10px;color: #3250C3;}
   .product-box .custom-product-price .original-price{font-weight: 500;color: #8D8D8D;text-decoration: line-through;}
   .product-box .custom-product-button{position: relative;left: 50%;transform: translateX(-50%);margin-top:14px;max-width:220px;min-width:220px}
   .slick-dotted .slick-dots{visibility:hidden}
 @media (max-width: 992px) {
  .product{margin-top:60px}
  .product h2{ font-size: 28px;}
  .product-box{margin-top:30px}
  .slick-dotted .slick-dots {margin-top:30px;display: flex ;visibility:visible;gap:8px;align-items: center;justify-content: center;}
  .product-box .item{
    border-radius: 20px;
    background: #F5F5F5;
    padding-bottom: 34px;}
    .slick-dotted .slick-dots .slick-active button{ background: #3250C3;}
    .slick-dotted .slick-dots button {
    padding:0px;
    width: 20px;
    height: 4px;
    border-radius:4px;
    background: #D9D9D9;
    color: transparent;
    transition: all .4s ease;
  }
}
  </style>
<div class="section scene-section" >
  <div class="page-width fullscreen-grid-section">
    <div class="section__wrapper grid-container">
          {% for block in section.blocks %}
            <div class="grid-item block-{{ forloop.index }}">
              <div class="image-container">
                {% if block.settings.image != blank %}
                  <picture>
                    <!-- 移动端图片 -->
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ block.settings.image | img_url: '800x' }} 1x,
                        {{ block.settings.image | img_url: '1600x' }} 2x
                      "
                    >

                    <!-- 桌面端图片 -->
                    <source
                      media="(min-width: 750px)"
                      srcset="
                        {{ block.settings.image | img_url: '1200x' }} 1x,
                        {{ block.settings.image | img_url: '2400x' }} 2x
                      "
                    >

                    <!-- 默认图片 -->
                    <img
                      src="{{ block.settings.image | img_url: '1200x' }}"
                      alt="{{ block.settings.title | escape }}"
                      class="grid-image"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </picture>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <div class="content-wrapper">
                <h2 class="grid-title">{{ block.settings.title }}</h2>
                <h4 class="grid-des">{{ block.settings.description }}</h4>
                {% if block.settings.button_link != blank %} 
                  <button
                    type="button"
                    class="btn btn--primary links"
                  >
                    <a href="{{ block.settings.button_link }}" class="grid-button">
                      {{ block.settings.button_title }}
                    </a>
                  </button>
                {% endif %} 
              </div>
            </div>
          {% endfor %}
       
    </div>
  </div>
 
</div>
<div class="section section--padding page-width product">
  <h2><span>Produktempfehlung</span></h2>
  <div class="slide-wrapper">
    <div class="grid product-box">
      {%- assign motion_delay = 50 -%}
      {% for block in section.blocks %}
        <div class="item">
          <motion-element   class="block rich-text__subheading"
            data-motion="fade-up"
            data-motion-delay="{{ motion_delay }}">
          <div class="imgs">
            {% if block.settings.image != blank %}
              <picture>
                <!-- 移动端图片 -->
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.image | img_url: '800x' }} 1x,
                    {{ block.settings.image | img_url: '1600x' }} 2x
                  "
                >

                <!-- 桌面端图片 -->
                <source
                  media="(min-width: 750px)"
                  srcset="
                    {{ block.settings.image | img_url: '1200x' }} 1x,
                    {{ block.settings.image | img_url: '2400x' }} 2x
                  "
                >

                <!-- 默认图片 -->
                <img
                  src="{{ block.settings.image | img_url: '1200x' }}"
                  alt="{{ block.settings.title | escape }}"
                  class="grid-image"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </picture>
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          </motion-element>
          <h3 class="custom-product-title">
            {% comment %} {{ block.settings.custom_title | default: block.settings.title }} {% endcomment %}
            SolidFlex 2000 + SFA1800
          </h3>
          <div class="custom-product-describe">
            {% comment %} {{ block.settings.custom_describe }} {% endcomment %}
            4*440W Bifaziales Solarmodul + 4*Flachdachhalter 
          </div>
          <div class="custom-product-price">
            <span class="current-price"> {{ block.settings.title | money }}</span>
            <span class="original-price">{{ block.settings.title | money }}</span>
          
          </div>
          
          <button class="btn btn--primary links custom-product-button">
            {{ block.settings.title }} 
          </button>
        </div>
        {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    $('.product-box').slick({
      dots: true,
      arrows: false,
      slidesToShow: 4,
      responsive: [ // 响应式配置
        {
          breakpoint: 767,
          settings: { slidesToShow: 3 }
        },
        {
          breakpoint: 640,
          settings: { slidesToShow: 1 }
        }
      ]
    });
  });

</script>
{% schema %}
{
  "name": "sections.scene-list",
  "tag": "section",
  "class": "section section-scene-list",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "分区标题",
      "default": "我们的特色分区"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "scene item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "image_pc"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "image_mobile"
        },
        {
          "type": "text",
          "id": "title",
          "label": "大标题"
        },
        {
          "type": "text",
          "id": "description",
          "label": "描述"
        },
        {
          "type": "text",
          "id": "button_title",
          "label": "按钮标题"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "场景列表",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
