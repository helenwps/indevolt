 {%- liquid
  assign motion_delay = 50

-%}
<style>
   .product-collection{margin-top:118px}
   .product-collection h2{ font-size: 46px;font-weight: 700;text-align:center;color:#000}
   .product-collection-box{margin-top:57px}
   .product-collection-box .slick-track{display:flex; gap:1rem}
   .product-collection-box .custom-product-title,.product-collection-box .custom-product-price{margin-top:20px;text-align: center; font-size: 20px;font-weight: 600;color: #1A1A1A;}
   .product-collection-box .custom-product-describe{min-height:34px;margin-top:5px;line-height: normal;font-size:14px;font-weight: 400;color: #1A1A1A;text-align: center;}
   .product-collection-box .custom-product-price{margin-top:1rem;color: #3250C3;}
   .product-collection-box .custom-product-price .original-price{font-weight: 500;color: #8D8D8D;text-decoration: line-through;}
   .product-collection-box .custom-product-button{display:flex;left: 50%;transform: translateX(-50%);margin-top:14px;max-width:220px;min-width:220px}
   .slick-dotted .slick-dots{visibility:hidden}
 @media (max-width: 1024px) {
 .product-collection-box .custom-product-button{min-width:160px;max-width:160px}
}
 @media (max-width: 1023px) {
 .slick-dotted .slick-dots {margin-top:30px;display: flex ;visibility:visible;gap:8px;align-items: center;justify-content: center;}
 .slick-dotted .slick-dots .slick-active button{ background: #3250C3;}
 .slick-dotted .slick-dots button {
    padding:0px;
    width: 20px;
    height: 4px;
    border-radius:4px;
    background: #D9D9D9;
    color: transparent;
    transition: all .4s ease;
  }
}
 @media (max-width: 768px) {
  .product-collection{margin-top:60px}
  .product-collection h2{ font-size: 28px;}
  .product-collection-box{margin-top:30px}
  .product-collection-box .item{border-radius: 20px;background: #F5F5F5;padding-bottom: 34px;}
  .product-collection-box .custom-product-describe{padding:0 4rem}

}

</style>
<div class="section section-product-collection section--padding page-width">
    <div class="product-collection">
      <h2> <motion-element class="block" data-motion="fade-up" data-motion-delay="{{ motion_delay }}"><span>{{section.settings.title}}</span></motion-element></h2>
      <div class="product-collection-box">
            {% for block in section.blocks %}
              {% assign product = all_products[block.settings.product_item] %}
              {% if product != blank %} 
                <div class="item slick-slide" >
                  <a href="{% if block.settings.button_link != blank %}{{  block.settings.button_link }}{% else %}{{ product.url }}{% endif %}" class="custom-product-card">
                    {% if block.settings.custom_image != blank %}
                      <div class="custom-product-image">
                        {{
                          block.settings.custom_image
                          | image_url: width: 600
                          | image_tag: loading: 'lazy', alt: block.settings.custom_title | default: product.title
                        }}
                      </div>
                    {% else %}
                     <div class="custom-product-image">
                        {{
                          product.featured_image
                          | image_url: width: 600
                          | image_tag: loading: 'lazy', alt: block.settings.title
                        }}
                      </div> 
                    {% endif %}
                    
                    <h3 class="custom-product-title">
                      {{ block.settings.custom_title | default: block.settings.title }}
                    </h3>
                    <div class="custom-product-describe">
                      {{ block.settings.custom_describe }}
                    </div>
                    <div class="custom-product-price">
                      <span class="current-price"> {{ block.settings.price }}</span>
                      <span class="original-price">{{ block.settings.original }}</span>
                     
                    </div>
                    
                    <button class="btn btn--primary links custom-product-button">
                      {{ block.settings.button_text }} 
                    </button>
                  </a>
                </div>
               {% endif %}
            {% endfor %} 
          </div>


  
    </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    $('.product-collection-box').slick({
      dots: true,
      arrows: false,
      slidesToShow: 4,
      responsive: [ // 响应式配置
        {
          breakpoint: 1023,
          settings: { slidesToShow: 2 }
        },
        {
          breakpoint: 640,
          settings: { 
            slidesToShow: 1,
            autoplay:true
          }
        }
      ]
    });
  });
</script>
{% schema %}
{
  "name": "product_collection",
  "tag": "section",
  "class": "section section-product-collection",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.all.grid.columns_desktop.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
     {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.all.mobile.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.all.mobile.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.all.mobile.columns_mobile.label"
    },
       {
      "type": "select",
      "id": "controls_position",
      "label": "t:sections.slideshow.settings.pagination_position.label",
      "options": [
        {
          "value": "inside",
          "label": "t:sections.slideshow.settings.pagination_position.options__1.label"
        },
        {
          "value": "outside",
          "label": "t:sections.slideshow.settings.pagination_position.options__2.label"
        }
      ],
      "default": "inside",
    },
  ],
 "blocks": [
    {
      "type": "card",
      "name": "产品",
      "settings": [
        {
          "type": "product",
          "id": "product_item",
          "label": "product"
        },
        
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "image_pc"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "image_mobile"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "自定义标题"
        },
          {
          "type": "text",
          "id": "custom_describe",
          "label": "自定义描述"
        },
         {
          "type": "text",
          "id": "price",
          "label": "定价"
        },
         {
          "type": "text",
          "id": "original",
          "label": "原价"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮标题"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "产品推荐",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
