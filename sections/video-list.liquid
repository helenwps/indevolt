<style>
  .section-video-list .slick-track {
    display: flex;
    gap: 1rem;
  }
  .iframe-carousel-container {
    margin-top: 58px;
    position: relative;
  }

  .iframe-carousel .carousel-slide {
    box-sizing: border-box;
  }
  .iframe-carousel iframe {
    width: 100%;
    height: 400px;
    border-radius: 8px;
  }
  .slide-caption {
    text-align: center;
    margin-top: 10px;
    font-size: 16px;
  }

  .carousel-arrows {
    position: absolute;
    top: 50%;
    width: 100%;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    z-index: 10;
  }

  .carousel-arrows button {
    background: rgba(50, 80, 195, 0.8);
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    padding: 0px;
    font-size: 12px;
    cursor: pointer;
    color: #fff;
    transition: all 0.3s;
  }

  .carousel-arrows button:hover {
    background: rgba(50, 80, 195, 1);
  }
  .carousel-arrows button.prev-arrow {
    left: 1rem;
  }
  .carousel-arrows button.next-arrow {
    right: 1rem;
  }
  @media (max-width: 767.98px) {
      .section-video-list{ margin:0px 1.24rem}
      .iframe-carousel-container{margin-top:30px}
      .section-video-list .slick-track{gap:0px}
      .iframe-carousel iframe{height:189px}
      .section-video-list .slick-dotted .slick-dots{margin-top:0px}
  }
</style>
<div class="section section-video-list">
  <div class="product-collection product-slider-container">
    <h2>
      <span>{{ section.settings.title }}</span>
    </h2>
    <!-- 主轮播 -->
    {% comment %}
      <div class="main-slider">
           {% for block in section.blocks %}
            <div class="slide">
            {% if block.settings.image != blank %}
                  <picture>
                    <!-- 移动端图片 -->
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ block.settings.image | img_url: '800x' }} 1x,
                        {{ block.settings.image | img_url: '1600x' }} 2x
                      "
                    >

                    <!-- 桌面端图片 -->
                    <source
                      media="(min-width: 750px)"
                      srcset="
                        {{ block.settings.image | img_url: '1200x' }} 1x,
                        {{ block.settings.image | img_url: '2400x' }} 2x
                      "
                    >

                    <!-- 默认图片 -->
                    <img
                      src="{{ block.settings.image | img_url: '1200x' }}"
                      alt="{{ block.settings.title | escape }}"
                      class="grid-image"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </picture>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
            </div>
        {% endfor %}

      </div>
    {% endcomment %}
    <div class="iframe-carousel-container">
      <div class="iframe-carousel">
        {% for block in section.blocks %}
          <!-- 示例循环，替换为你的实际内容 -->
          <div class="carousel-slide">
            {% comment %} <iframe src="{{  block.settings.video_url }}" frameborder="0" controls allowfullscreen loading="eager"></iframe> {% endcomment %}
            <iframe
              src="https://www.youtube.com/embed/{{ block.settings.video_url }}?rel=0&amp;controls=1&amp;showinfo=0&amp;autoplay=1&amp;loop=1&amp;mute=1&enablejsapi=1"
              allow="autoplay; encrypted-media"
              allowfullscreen
              class="embed-responsive-item"
              loading="eager"
            ></iframe>
          </div>
        {% endfor %}
      </div>

      <div class="carousel-arrows">
        <button class="prev-arrow">❮</button>
        <button class="next-arrow">❯</button>
      </div>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
    $('.iframe-carousel').slick({
      slidesToShow: 2.5, // 显示两屏半
      slidesToScroll: 1, // 每次滚动一屏
      infinite: true, // 无限循环
      arrows: true, // 显示箭头
      prevArrow: $('.prev-arrow'), // 自定义上一页箭头
      nextArrow: $('.next-arrow'), // 自定义下一页箭头
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1.5,
          },
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            dots: true,
          },
        },
      ],
    });
  });
</script>
{% schema %}
{
  "name": "video-list",
  "tag": "section",
  "class": "section section-video-list",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Kundenbewertungen"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "video item",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["vimeo", "youtube"],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
          "label": "视频"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "视频列表",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
