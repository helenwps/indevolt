<style>
  .section-video-list .slick-track {display: flex;gap: 1rem}
  .iframe-carousel-container {margin-top: 58px;position: relative}
  .iframe-carousel .carousel-slide {box-sizing: border-box}
  .video-container {position: relative;width: 100%;padding-bottom: 56.25%;border-radius: 12px;overflow: hidden;
   box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);background: #000;transition: all 0.3s ease}
  .video-container:hover {box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2)}
  .iframe-carousel iframe {position: absolute;top: 0;left: 0;width: 100%;height: 100%;border: none}     
  .slide-caption {text-align: center;margin-top: 10px;font-size: 16px}
  .carousel-arrows {position: absolute;top: 50%;width: 100%;display: flex;justify-content: space-between;transform: translateY(-50%);
    z-index: 10}
  .carousel-arrows button {background:rgba(118, 118, 118, 0.2);border: none;width: 48px;height: 48px;border-radius: 50%;padding: 0px;
   font-size: 14px;cursor: pointer;color: #fff;transition: all 0.3s}
  .carousel-arrows button:hover {background: rgba(118, 118, 118, 0.5)}
  .carousel-arrows button.prev-arrow {left: 60px;}
  .carousel-arrows button.next-arrow {right: 60px;}
  @media (max-width: 767.98px) {
    .section-video-list{ margin:0px 1.24rem}
    .iframe-carousel-container{margin-top:30px}
    .section-video-list .slick-track{gap:0px}
    .iframe-carousel iframe{height:189px}
    .section-video-list .slick-dotted .slick-dots{margin-top:0px}
    .carousel-arrows button{width:38px;height:38px}
    .carousel-arrows button.prev-arrow{left:10px}
    .carousel-arrows button.next-arrow {right: 10px}
  }
</style>
{% liquid
    assign motion_delay = 50
%}
<div class="section section-video-list">
  <div class="product-collection product-slider-container">
    <h2>
      <motion-element class="block" data-motion="fade-up" data-motion-delay="{{ motion_delay }}">  <span>{{ section.settings.title }}</span></motion-element>
    </h2>
    <div class="iframe-carousel-container">
      <div class="iframe-carousel">
        {% for block in section.blocks %}
          {%- liquid
            # 从每个区块的视频URL中提取视频ID
            assign video_url = block.settings.video_url
            assign video_id = ""
            
            # 处理不同格式的YouTube URL
            if video_url contains "youtube.com/watch?v="
              assign video_id = video_url | split: '?v=' | last | split: '&' | first
            elsif video_url contains "youtu.be/"
              assign video_id = video_url | split: '.be/' | last | split: '?' | first
            elsif video_url contains "youtube.com/embed/"
              assign video_id = video_url | split: '/embed/' | last | split: '?' | first
            endif
          -%}
          
          {% if video_id != "" %}
            <div class="carousel-slide">
              <div class="video-container">
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0&amp;controls=1&amp;showinfo=0&amp;autoplay=0&amp;loop=1&amp;mute=1&enablejsapi=1"
                allow="autoplay; encrypted-media"
                allowfullscreen
                class="embed-responsive-item"
                loading="lazy"
                data-video-id="{{ video_id }}"
              ></iframe>
              </div>
            </div>
          {% else %}
            <div class="carousel-slide error-slide">
              <p>无效的视频URL: {{ video_url }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="carousel-arrows">
        <button class="prev-arrow">❮</button>
        <button class="next-arrow">❯</button>
      </div>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
    $('.iframe-carousel').slick({
      slidesToShow: 2.5, // 显示两屏半
      slidesToScroll: 1, // 每次滚动一屏
      infinite: true, // 无限循环
      arrows: true, // 显示箭头
      speed: 300,
      adaptiveHeight: true,
      prevArrow: $('.prev-arrow'), // 自定义上一页箭头
      nextArrow: $('.next-arrow'), // 自定义下一页箭头
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1.5,
          },
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            dots: true,
          },
        },
      ],
    });
    // 暂停其他视频当新幻灯片激活时
    $('.iframe-carousel').on('beforeChange', function(event, slick, currentSlide, nextSlide){
      // 暂停当前播放的视频
      const currentIframe = $(slick.$slides[currentSlide]).find('iframe')[0];
      if (currentIframe) {
        currentIframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
      }
    });
    
    // 视频点击处理 - 在移动设备上全屏播放
    $('.carousel-slide').on('click', function() {
      const iframe = $(this).find('iframe')[0];
      if (iframe) {
        const videoId = $(this).find('iframe').data('video-id');
        if (videoId) {
          // 在移动设备上，使用YouTube应用打开以获得更好体验
          if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
            window.open(`https://www.youtube.com/watch?v=${videoId}`, '_blank');
          } else {
            // 在桌面设备上，直接播放
            iframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
          }
        }
      }
    });
  });
</script>
{% schema %}
{
  "name": "video-list",
  "tag": "section",
  "class": "section section-video-list",
  "max_blocks": 10,
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Kundenbewertungen"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "video item",
      "settings": [
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["vimeo", "youtube"],
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
          "label": "视频"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "视频列表",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
