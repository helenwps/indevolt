<style>
 .section-service-info {margin-bottom:120px}
 .section-service-info h2{ padding-bottom:57px;}
  @media (max-width: 768px) {
    .section-service-info {margin-bottom:60px}
    .section-service-info h2{padding-bottom: 30px;}
  }
</style>
{% liquid
    assign motion_delay = 50
%}
<div class="section section--padding page-width section-service-info" style="margin-top:{{section.settings.margin_top  }}px;margin-bottom:{{section.settings.margin_bottom  }}px;">
  <div class="product-collection product-slider-container">
    {% if section.settings.title != blank %}
    <h2>
      <motion-element class="block" data-motion="fade-up" data-motion-delay="{{ motion_delay }}"> <span>{{ section.settings.title }}</span></motion-element>
    </h2>
    {% endif %}
    {% if section.settings.image_pc != blank %}
        <picture>
          <!-- 移动端图片 -->
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | img_url: '800x' }} 1x,
              {{ section.settings.image_mobile | img_url: '1600x' }} 2x
            "
          >

          <!-- 桌面端图片 -->
          <source
            media="(min-width: 750px)"
            srcset="
              {{ section.settings.image_pc | img_url: '1200x' }} 1x,
              {{ section.settings.image_pc | img_url: '2400x' }} 2x
            "
          >

          <!-- 默认图片 -->
          <img
            src="{{ section.settings.image_pc | img_url: '1200x' }}"
            alt="{{ section.settings.title | escape }}"
            class="service-image"
            loading="lazy"
            width="{{ section.settings.image_pc.width }}"
            height="{{ section.settings.image_pc.height }}"
          >
        </picture>
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "service-info",
  "tag": "section",
  "class": "section section-service-info",
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Kundenbewertungen"
    },
    {
    "type": "image_picker",
    "id": "image_pc",
      "label": "PC端图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "手机端图片"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "顶部填充",
      "default": 0,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "底部填充",
      "default": 0,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "服务信息"
    }
  ]
}
{% endschema %}
